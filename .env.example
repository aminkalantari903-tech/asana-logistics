# Iran Freight Atlas — تنظیمات محرمانهٔ سرور (این فایل را به .env تغییر نام دهید؛ هرگز در گیت/مخزن عمومی نگذارید)
# مدل زبانی برای عامل‌های هوشمند (Anthropic Messages API یا واسط سازگار با آن)
IFA_LLM_PROVIDER=anthropic
IFA_LLM_URL=https://api.anthropic.com
IFA_LLM_MODEL=claude-sonnet-4-5
IFA_LLM_KEY=
IFA_LLM_LABEL=
IFA_LLM_VISION=1
# دلار به‌ازای یک میلیون توکن (برای سقف هزینهٔ روزانه)
IFA_LLM_PRICE_IN=3
IFA_LLM_PRICE_OUT=15
IFA_LLM_MAX_TOKENS=2048
IFA_LLM_TIMEOUT=120
# ضریب سهمیهٔ روزانهٔ توکن/هزینهٔ هر عامل (۱ = پیش‌فرض)
IFA_AG_BUDGET_SCALE=1

# ورود به سرور تیمی: open (بدون رمز، پیش‌فرض) | password
IFA_AUTH=open
# lan = فقط شبکهٔ داخلی (پیش‌فرض) | all = همه‌جا (خطرناک)
IFA_OPEN_SCOPE=lan
# نقش دستگاه‌های جدید: admin | manager | ops | finance | sales | viewer
IFA_OPEN_ROLE=admin

# --- جستجوی وب دستیار و عامل‌ها (v15.10) — یکی کافی است؛ بدون آن‌ها موتورهای بدون کلید امتحان می‌شوند
# IFA_SEARCH_URL=http://127.0.0.1:8888      # SearxNG داخلی (پیشنهادی)
# IFA_TAVILY_KEY=
# IFA_GOOGLE_KEY=
# IFA_GOOGLE_CX=
# IFA_BRAVE_KEY=
# IFA_SEARCH_ORDER=searxng,tavily,google,brave,duckduckgo,gnews,bing,wikipedia
# IFA_SEARCH=off

# --- داده‌های ایران (v15.17 · سرور 1.12)
# صفحهٔ پیش‌نمایش کانال‌های عمومی تلگرام (یا یک واسط/آینهٔ مجاز اگر سرور به t.me دسترسی ندارد)
# IFA_TG_WEB=https://t.me/s/
# نشانی API ربات‌ها (پیش‌فرض رسمی؛ برای واسط مجاز تغییر دهید)
# IFA_TG_API=https://api.telegram.org/bot
# IFA_BALE_API=https://tapi.bale.ai/bot
# منبع JSON نرخ ارز گمرکی، مثلاً {"date":"2026-10-08","rates":{"USD":285000,"EUR":310000}} — هر ۱۲ ساعت خوانده می‌شود
# IFA_CUSTOMS_FX_URL=
